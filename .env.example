# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Default model for every agent step. The writer can use a stronger model if quality needs it.
SPENDAUDITOR_MODEL=claude-haiku-5-5
SPENDAUDITOR_WRITER_MODEL=claude-haiku-5-5

# The app's own AI spend cap (USD per day). Calls are refused once it is reached.
SPENDAUDITOR_DAILY_BUDGET_USD=1.00

# Web search costs $10 per 1,000 searches. Off by default while developing.
SPENDAUDITOR_WEB_SEARCH=false
